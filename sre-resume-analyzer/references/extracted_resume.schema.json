{
  "$defs": {
    "BasicInfo": {
      "additionalProperties": false,
      "properties": {
        "contact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Contact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "degree": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Degree",
          "type": "string"
        },
        "graduation_year": {
          "maximum": 2200,
          "minimum": 1900,
          "title": "Graduation Year",
          "type": "integer"
        },
        "major": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Major",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "school": {
          "maxLength": 512,
          "minLength": 1,
          "title": "School",
          "type": "string"
        }
      },
      "required": [
        "name",
        "school",
        "major",
        "degree",
        "graduation_year"
      ],
      "title": "BasicInfo",
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Email",
          "type": "string"
        },
        "phone": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Phone",
          "type": "string"
        }
      },
      "required": [
        "phone",
        "email"
      ],
      "title": "Contact",
      "type": "object"
    },
    "Internship": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Achievements",
          "type": "array"
        },
        "company": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "duration": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Duration",
          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tech_stack": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tech Stack",
          "type": "array"
        }
      },
      "required": [
        "company",
        "role",
        "duration",
        "description",
        "tech_stack",
        "achievements"
      ],
      "title": "Internship",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Achievements",
          "type": "array"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "duration": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Duration",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "tech_stack": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tech Stack",
          "type": "array"
        }
      },
      "required": [
        "name",
        "role",
        "duration",
        "description",
        "tech_stack",
        "achievements"
      ],
      "title": "Project",
      "type": "object"
    },
    "Skills": {
      "additionalProperties": false,
      "properties": {
        "cicd_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Cicd Tools",
          "type": "array"
        },
        "cloud_platforms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Cloud Platforms",
          "type": "array"
        },
        "container_tech": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Container Tech",
          "type": "array"
        },
        "monitoring_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Monitoring Tools",
          "type": "array"
        },
        "programming_languages": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Programming Languages",
          "type": "array"
        }
      },
      "required": [
        "programming_languages",
        "monitoring_tools",
        "container_tech",
        "cloud_platforms",
        "cicd_tools"
      ],
      "title": "Skills",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only accepted structured input shape for analyzer v3.",
  "properties": {
    "basic_info": {
      "$ref": "#/$defs/BasicInfo"
    },
    "internships": {
      "items": {
        "$ref": "#/$defs/Internship"
      },
      "title": "Internships",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "resume_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Id"
    },
    "skills": {
      "$ref": "#/$defs/Skills"
    }
  },
  "required": [
    "basic_info",
    "internships",
    "projects",
    "skills"
  ],
  "title": "Resume",
  "type": "object"
}
